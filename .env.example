# Токен бота из @BotFather (формат: 1234567890:AAH...)
BOT_TOKEN=

# Главный администратор (Khamoi) — уже зашит в render.yaml
ADMIN_ID=5208615220

# Supabase → Settings → API → Project URL
SUPABASE_URL=

# Supabase → Settings → API → service_role (секретный ключ, не anon!)
SUPABASE_SERVICE_ROLE_KEY=

# Придумайте случайную строку (например, 32+ символов)
WEBHOOK_SECRET=

# Публичный HTTPS-URL Render-сервиса (например, https://istoriya.onrender.com)
MINI_APP_URL=

# Приватный Storage bucket в Supabase
STORAGE_BUCKET=history-media
